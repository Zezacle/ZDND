properties:
  note.material component:
    displayName: material_component
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("spell")
    groupBy:
      property: spell_level
      direction: ASC
    order:
      - file.name
      - spell_level
      - school
      - ritual
      - material_component
      - concentration
      - file.tags
    sort:
      - property: school
        direction: ASC
    columnSize:
      note.spell_level: 30
