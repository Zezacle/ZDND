properties:
  note.material component:
    displayName: material_component
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("spell")
        - and:
            - file.hasTag("spell-list/wizard")
    order:
      - file.name
      - spell_level
      - school
      - ritual
      - material_component
      - concentration
      - file.tags
    sort:
      - property: spell_level
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.spell_level: 30
