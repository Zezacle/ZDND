properties:
  file.name:
    displayName: Spell Name
  note.school:
    displayName: School
  note.spell_level:
    displayName: Spell Level
  note.ritual:
    displayName: Ritual
  note.material_component:
    displayName: Material Component
  note.concentration:
    displayName: Concentration
  note.cast-time:
    displayName: Casting Time
  note.range:
    displayName: Range
  note.duration:
    displayName: Duration
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("spell-list/ranger")
    groupBy:
      property: spell_level
      direction: ASC
    order:
      - spell_level
      - file.name
      - school
      - cast-time
      - range
      - duration
      - concentration
      - ritual
      - material_component
    sort:
      - property: spell_level
        direction: DESC
    columnSize:
      note.spell_level: 117
